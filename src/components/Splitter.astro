<section class="card" id="splitCard" style="display:none;">
  <h2>Split into subnets</h2>
  <div class="range-row">
    <span>New prefix</span>
    <span class="value" id="newPrefixVal">/26</span>
  </div>
  <input id="newPrefix" type="range" min="1" max="32" value="26" />
  <p id="splitCount" class="split-count"></p>
  <button id="splitBtn" class="btn btn-primary" type="button">Split</button>
  <p id="splitError" class="error-msg" style="display:none;"></p>
  <div id="splitResults" class="split-results"></div>
</section>

<style>
  .range-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted); font-weight: 500; margin-bottom: 0.5rem; }
  .range-row .value { font-family: var(--mono); font-size: 0.8rem; color: var(--fg); background: var(--bg); border: 1px solid var(--border); padding: 0.1rem 0.5rem; border-radius: 6px; }
  input[type='range'] { width: 100%; height: 4px; appearance: none; background: var(--border); border-radius: var(--radius-pill); outline: none; margin-bottom: 1rem; }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  .split-count { font-size: 0.82rem; color: var(--fg-muted); margin: 0 0 0.75rem; }
  .btn { display: inline-flex; align-items: center; justify-content: center; width: 100%; padding: 0.75rem 1rem; border-radius: var(--radius-pill); border: 1px solid transparent; font: inherit; font-weight: 500; font-size: 0.88rem; cursor: pointer; }
  .btn-primary { background: var(--fg); color: var(--bg); }
  .btn-primary:hover { opacity: 0.9; }
  .error-msg { color: var(--danger); font-size: 0.85rem; margin: 0.75rem 0 0; }
  .split-results { margin-top: 1rem; max-height: 320px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); }
  .split-results table { width: 100%; border-collapse: collapse; font-family: var(--mono); font-size: 0.78rem; }
  .split-results th, .split-results td { padding: 0.4rem 0.6rem; text-align: left; border-bottom: 1px solid var(--border); }
  .split-results th { color: var(--fg-muted); font-weight: 500; position: sticky; top: 0; background: var(--bg); }
  .split-results tr:last-child td { border-bottom: none; }
</style>
